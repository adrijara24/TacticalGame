<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Tactical.Editor.ViewModels"
             mc:Ignorable="d"
             x:Class="Tactical.Editor.Views.AssetIdPickerView"
             x:DataType="vm:AssetIdPickerViewModel">

    <ComboBox ItemsSource="{Binding ResourceIds}"
              SelectedItem="{Binding SelectedId, Mode=TwoWay}"
              HorizontalAlignment="Stretch" />
</UserControl>