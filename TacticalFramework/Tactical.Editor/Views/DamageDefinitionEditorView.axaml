<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Tactical.Editor.ViewModels"
             mc:Ignorable="d"
             x:Class="Tactical.Editor.Views.DamageDefinitionEditorView"
             x:DataType="vm:DamageDefinitionEditorViewModel">

    <Grid ColumnDefinitions="140,*"
          RowDefinitions="Auto,Auto"
          RowSpacing="8"
          ColumnSpacing="12">

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Formula" VerticalAlignment="Center" />
        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Formula}" />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Damage Type" VerticalAlignment="Center" />
        <ComboBox Grid.Row="1"
                  Grid.Column="1"
                  ItemsSource="{Binding DamageTypes}"
                  SelectedItem="{Binding DamageType}" />

    </Grid>
</UserControl>