<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Tactical.Editor.ViewModels"
             x:Class="Tactical.Editor.Views.MapEditorView"
             x:DataType="vm:MapEditorViewModel">

    <Grid RowDefinitions="Auto,*,Auto"
          Margin="16,16,16,0"
          RowSpacing="12">

        <Grid ColumnDefinitions="*,*,*,*,*"
              ColumnSpacing="10">

            <TextBlock Grid.Column="0"
                       Text="ID"
                       VerticalAlignment="Center" />

            <TextBox Grid.Column="1"
                     Text="{Binding Id}" />

            <TextBlock Grid.Column="2"
                       Text="Name"
                       VerticalAlignment="Center" />

            <TextBox Grid.Column="3"
                     Text="{Binding Name}" />

            <Grid Grid.Column="4"
                  ColumnDefinitions="Auto,70,Auto,70"
                  ColumnSpacing="6">

                <TextBlock Text="W"
                           VerticalAlignment="Center" />

                <NumericUpDown Grid.Column="1"
                               Value="{Binding Width}"
                               Minimum="1"
                               Maximum="500" />

                <TextBlock Grid.Column="2"
                           Text="H"
                           VerticalAlignment="Center" />

                <NumericUpDown Grid.Column="3"
                               Value="{Binding Height}"
                               Minimum="1"
                               Maximum="500" />

            </Grid>

        </Grid>

        <Grid Grid.Row="1"
              ColumnDefinitions="3*,1*"
              ColumnSpacing="12">

            <Border Grid.Column="0"
                    BorderThickness="1"
                    Padding="8">

                <Grid RowDefinitions="Auto,*"
                      RowSpacing="8">

                    <TextBlock Text="{Binding SelectedTileId}"
                               Opacity="0.7" />

                    <ScrollViewer Grid.Row="1"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">

                        <ItemsControl ItemsSource="{Binding Cells}"
                                      PointerPressed="MapCell_PointerPressed"
                                      DragDrop.AllowDrop="True"
                                      DragDrop.DragOver="MapCell_DragOver"
                                      DragDrop.Drop="MapCell_Drop">

                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="{Binding Width}"
                                                 HorizontalAlignment="Left"
                                                 VerticalAlignment="Top" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>

                                    <Border Width="76"
                                            Height="76"
                                            BorderThickness="1"
                                            Padding="3"
                                            Background="Transparent"
                                            ToolTip.Tip="{Binding TileId}">

                                        <StackPanel VerticalAlignment="Center"
                                                    HorizontalAlignment="Center"
                                                    Spacing="2">

                                            <TextBlock Text="{Binding TileName}"
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       FontWeight="Bold"
                                                       FontSize="11" />

                                            <TextBlock Text="{Binding TileId}"
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       FontSize="9"
                                                       Opacity="0.7" />

                                        </StackPanel>

                                    </Border>

                                </DataTemplate>
                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </ScrollViewer>

                </Grid>

            </Border>

            <Border Grid.Column="1"
                    BorderThickness="1"
                    Padding="10">

                <Grid RowDefinitions="Auto,Auto,*"
                      RowSpacing="8">

                    <TextBlock Text="Tiles"
                               FontSize="18"
                               FontWeight="Bold" />

                    <TextBox Grid.Row="1"
                             Watermark="Search tiles..."
                             Text="{Binding SearchText}" />

                    <ListBox Grid.Row="2"
                             ItemsSource="{Binding VisibleTiles}"
                             PointerPressed="TilePaletteItem_PointerPressed">

                        <ListBox.ItemTemplate>
                            <DataTemplate>

                                <Border Padding="6">

                                    <Grid ColumnDefinitions="*,Auto"
                                          ColumnSpacing="8">

                                        <TextBlock Text="{Binding Name}"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap" />

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding TileId}"
                                                   VerticalAlignment="Center"
                                                   Opacity="0.7"
                                                   FontSize="10" />

                                    </Grid>

                                </Border>

                            </DataTemplate>
                        </ListBox.ItemTemplate>

                    </ListBox>

                </Grid>

            </Border>

        </Grid>

        <Grid Grid.Row="2"
              RowDefinitions="Auto,Auto"
              RowSpacing="8">

            <TextBox Grid.Row="0"
                     Text="{Binding Description}"
                     Watermark="Description"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     MinHeight="50" />

            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="8">

                <TextBlock Text="{Binding ErrorMessage}"
                           VerticalAlignment="Center"
                           Margin="0,0,16,0" />

                <Button Content="Cancel"
                        Command="{Binding CancelCommand}" />

                <Button Content="Save"
                        Command="{Binding SaveCommand}" />

            </StackPanel>

        </Grid>

    </Grid>

</UserControl>