<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Tactical.Editor.ViewModels"
             x:Class="Tactical.Editor.Views.MapEditorView"
             x:DataType="vm:MapEditorViewModel"
             DragDrop.AllowDrop="True">

    <UserControl.Styles>
        <Style Selector="Border.map-cell.drop-target">
            <Setter Property="BorderThickness"
                    Value="3" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource SystemControlHighlightAccentBrush}" />
            <Setter Property="Background"
                    Value="{DynamicResource SystemControlHighlightAltListAccentLowBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto"
          Margin="16,16,16,0"
          RowSpacing="10">

        <!-- Header -->
        <Grid ColumnDefinitions="Auto,160,Auto,170,Auto,*,Auto,105,Auto,105"
              ColumnSpacing="8">

            <TextBlock Grid.Column="0"
                       Text="ID"
                       VerticalAlignment="Center" />

            <TextBox Grid.Column="1"
                     Text="{Binding Id}" />

            <TextBlock Grid.Column="2"
                       Text="Name"
                       VerticalAlignment="Center"
                       Margin="12,0,0,0" />

            <TextBox Grid.Column="3"
                     Text="{Binding Name}" />

            <TextBlock Grid.Column="4"
                       Text="Description"
                       VerticalAlignment="Center"
                       Margin="12,0,0,0" />

            <TextBox Grid.Column="5"
                     Text="{Binding Description}"
                     Watermark="Description"
                     HorizontalAlignment="Stretch" />

            <TextBlock Grid.Column="6"
                       Text="W"
                       VerticalAlignment="Center"
                       Margin="12,0,0,0" />

            <NumericUpDown Grid.Column="7"
                           Value="{Binding Width, Mode=TwoWay}"
                           Minimum="1"
                           Maximum="500"
                           FormatString="0"
                           TextAlignment="Center"
                           HorizontalContentAlignment="Center" />

            <TextBlock Grid.Column="8"
                       Text="H"
                       VerticalAlignment="Center"
                       Margin="8,0,0,0" />

            <NumericUpDown Grid.Column="9"
                           Value="{Binding Height, Mode=TwoWay}"
                           Minimum="1"
                           Maximum="500"
                           FormatString="0"
                           TextAlignment="Center"
                           HorizontalContentAlignment="Center" />

        </Grid>

        <!-- Map + Tile palette -->
        <Grid Grid.Row="1"
              ColumnDefinitions="3*,1*"
              ColumnSpacing="12">

            <!-- Map -->
            <Border Grid.Column="0"
                    BorderThickness="1"
                    Padding="8">

                <Grid RowDefinitions="Auto,*"
                      RowSpacing="8">

                    <TextBlock Text="{Binding SelectedTileId, StringFormat='Selected: {0}'}"
                               Opacity="0.7" />

                    <ScrollViewer Grid.Row="1"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">

                        <ItemsControl ItemsSource="{Binding Cells}">

                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="{Binding Width}"
                                                 HorizontalAlignment="Left"
                                                 VerticalAlignment="Top" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>

                                    <Border Classes="map-cell"
                                            Width="76"
                                            Height="76"
                                            BorderThickness="1"
                                            BorderBrush="{DynamicResource SystemControlHighlightAltBaseLowBrush}"
                                            Padding="3"
                                            Background="Transparent"
                                            ToolTip.Tip="{Binding TileId}">

                                        <StackPanel VerticalAlignment="Center"
                                                    HorizontalAlignment="Center"
                                                    Spacing="2">

                                            <TextBlock Text="{Binding TileName}"
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       FontWeight="Bold"
                                                       FontSize="11" />

                                            <TextBlock Text="{Binding TileId}"
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       FontSize="9"
                                                       Opacity="0.7" />

                                        </StackPanel>

                                    </Border>

                                </DataTemplate>
                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </ScrollViewer>

                </Grid>

            </Border>

            <!-- Tile palette -->
            <Border Grid.Column="1"
                    BorderThickness="1"
                    Padding="10">

                <Grid RowDefinitions="Auto,Auto,*"
                      RowSpacing="8">

                    <TextBlock Text="Tiles"
                               FontSize="18"
                               FontWeight="Bold" />

                    <TextBox Grid.Row="1"
                             Watermark="Search tiles..."
                             Text="{Binding SearchText}" />

                    <ListBox Grid.Row="2"
                             ItemsSource="{Binding VisibleTiles}">

                        <ListBox.ItemTemplate>
                            <DataTemplate>

                                <Border Padding="6">

                                    <Grid ColumnDefinitions="*,Auto"
                                          ColumnSpacing="8">

                                        <TextBlock Text="{Binding Name}"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap" />

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding TileId}"
                                                   VerticalAlignment="Center"
                                                   Opacity="0.7"
                                                   FontSize="10" />

                                    </Grid>

                                </Border>

                            </DataTemplate>
                        </ListBox.ItemTemplate>

                    </ListBox>

                </Grid>

            </Border>

        </Grid>

        <!-- Save / Cancel -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8">

            <TextBlock Text="{Binding ErrorMessage}"
                       VerticalAlignment="Center"
                       Margin="0,0,16,0" />

            <Button Content="Cancel"
                    Command="{Binding CancelCommand}" />

            <Button Content="Save"
                    Command="{Binding SaveCommand}" />

        </StackPanel>

    </Grid>

</UserControl>